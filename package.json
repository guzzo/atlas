{
  "name": "passport-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "generate": "node scripts/generate-contract.mjs && openapi-typescript api/openapi.json -o sdk/generated.ts",
    "demo": "tsx scripts/demo.ts",
    "agent": "tsx apps/agent/cli.ts",
    "mcp": "tsx apps/agent/mcp.ts",
    "benchmark": "tsx scripts/benchmark.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "canonicalize": "^2.1.0",
    "jsonc-parser": "^3.3.1",
    "openapi-fetch": "^0.17.0",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "openapi-typescript": "^7.10.1",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
